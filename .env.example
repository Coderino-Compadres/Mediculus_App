DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
# Origins must include the scheme, e.g. https://example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# 'true' (default) behind a TLS-terminating proxy such as Azure App Service;
# 'false' for a directly-reachable server like the local dev server
DJANGO_USE_PROXY_SSL_HEADER=

DJANGO_REGISTRY_NAME=
DJANGO_LOGIN_SERVER=
DJANGO_USERNAME=
DJANGO_PASSWORD=

# 'require' for Azure Postgres (default if unset), 'disable' for a local dev container
DB_SSLMODE=

USER_DB_NAME=
USER_DB_USER=
USER_DB_PASSWORD=
USER_DB_HOST=
USER_DB_PORT=

MEDICAL_DB_NAME=
MEDICAL_DB_USER=
MEDICAL_DB_PASSWORD=
MEDICAL_DB_HOST=
MEDICAL_DB_PORT=