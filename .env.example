# Copy this file to '.env.local' (local Postgres container) and/or '.env.azure'
# (shared dev databases on Azure), then fill in the values.
# settings.py reads '.env.local' by default; pick the other one per command with
# DJANGO_ENV_FILE=.env.azure. Neither file is read on Azure App Service — there
# the same keys live in Application Settings.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
# Origins must include the scheme, e.g. https://example.com.
# CSRF_TRUSTED_ORIGINS must list the frontend's own origin (http://localhost:5173
# for `npm run dev`) even when it reaches the API through the vite /api proxy:
# the proxy rewrites Host, so Django's CSRF origin check has nothing else to
# match the browser's Origin against.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# 'true' (default) behind a TLS-terminating proxy such as Azure App Service;
# 'false' for a directly-reachable server like the local dev server
DJANGO_USE_PROXY_SSL_HEADER=
# 'true' only when the frontend is served from a different site than this API,
# which makes the session cookie SameSite=None; Secure (https-only). Leave unset
# for the vite /api proxy or a frontend served from the same origin.
DJANGO_CROSS_SITE_COOKIES=

DJANGO_REGISTRY_NAME=
DJANGO_LOGIN_SERVER=
DJANGO_USERNAME=
DJANGO_PASSWORD=

# 'require' for Azure Postgres (default if unset), 'disable' for a local dev container
DB_SSLMODE=

USER_DB_NAME=
USER_DB_USER=
USER_DB_PASSWORD=
USER_DB_HOST=
USER_DB_PORT=

MEDICAL_DB_NAME=
MEDICAL_DB_USER=
MEDICAL_DB_PASSWORD=
MEDICAL_DB_HOST=
MEDICAL_DB_PORT=